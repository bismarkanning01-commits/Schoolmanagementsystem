APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=mysql+pymysql://db_user:db_password@db_host/School_db?charset=utf8mb4

# These are required only until the first Super Admin is created.
SUPER_ADMIN_USERNAME=your-super-admin-username
SUPER_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
SUPER_ADMIN_EMAIL=admin@example.com

# Configure these to enable password reset emails.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-smtp-account@example.com
MAIL_PASSWORD=your-smtp-app-password
